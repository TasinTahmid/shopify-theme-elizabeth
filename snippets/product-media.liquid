{% case media.media_type %}
  {% when 'image' %}
    <img
      class="product-image"
      src="{{ media |  image_url }}"
      alt="{{ media.preview_image.alt }}"
      width="100%"
      height="100%"
    >

  {% when 'external_video' %}
    {{ media | external_video_tag: class: 'product-videos' }}

  {% when 'video' %}
    {{ media | video_tag: class: 'product-videos', controls: true }}

  {% when 'model' %}
    {{ medi | model_viewer_tag }}

  {% else %}
    {{ media | media_tag }}
{% endcase %}
