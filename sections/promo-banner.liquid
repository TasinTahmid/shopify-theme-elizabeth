<link rel="stylesheet" href="{{ 'promo-banner.css' | asset_url }}">

<div
  class="promo-banner"
  style="
    background-image: url(
    {% if section.settings.banner_image != blank %}
      {{ section.settings.banner_image | image_url  }}
    {% else %}
      'https://i.imghippo.com/files/MNnr3617mk.jpg'
    {% endif %}
      );
  "
>
  <div>&nbsp;</div>

  <div class="banner-messages">
    <div class="message-wrapper">
      <div class="banner-title">{{ section.settings.banner_title }}</div>
      <div class="banner-subtitle">{{ section.settings.banner_subtitle }}</div>
    </div>
  </div>

  <div class="link-buttons">
    <div class="link-wrapper">
      {% for block in section.blocks %}
        {% if block.type == 'button' and block.settings.button_label != blank and block.settings.button_url != blank %}
          <a
            href="{{ block.settings.button_url }}"
            class="links"
          >
            {{ block.settings.button_label }}
          </a>
        {% endif %}
      {% endfor %}
    </div>
    <div class="section-text-under-button">{{ section.settings.section_text_under_button }}</div>
  </div>
</div>

{% schema %}
{
  "name": "Promo Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image"
    },
    {
      "type": "text",
      "id": "banner_title",
      "label": "Banner Title",
      "default": "A/B Testing Development, Full Stack & Quality Assurance"
    },
    {
      "type": "text",
      "id": "banner_subtitle",
      "label": "Banner Subtitle",
      "default": "We provide high-quality development services without costing the world!"
    },
    {
      "type": "text",
      "id": "section_text_under_button",
      "default": "EchoLogyx Inc. Florida, USA with EIN 92-0677155.",
      "label": "Section Text Under Button"
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo Banner"
    }
  ]
}
{% endschema %}
