<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<link rel="stylesheet" href="{{ 'collection-hero-section.css' | asset_url }}">

<style>
  .swiper-button-prev,
  .swiper-button-next {
    color: rgb(255, 255, 255) !important;
    height: 20px;
  }
  .swiper-button-prev::after,
  .swiper-button-next::after {
    font-size: 20px;
  }
  .swiper-pagination {
    color: black;
    bottom: 16px !important;
  }
  .swiper-pagination-bullet-active {
    background: black !important;
  }
  .product--details {
    height: fit-content;
  }
</style>

{% comment %} {% assign collections = collections %} {% endcomment %}

<div class="collections-hero-section">
  <div class="collection-media-swipper">
    <div class="swiper swiper-hero-slider swiper-custom-property">
      <div class="swiper-wrapper">
        {% for collection in collections %}
          {% if collection.featured_image != blank %}
            {% assign collection_image = collection.featured_image %}
          {% else %}
            {% assign collection_image = collection.products.first.image %}
          {% endif %}
          <div class="swiper-slide">
            <div
              class="slider-content"
              style="
                                background-image: url(
                {% if collection_image != blank %}
                {{ collection_image | image_url  }}
                {% else %}
                'https://i.imghippo.com/files/MNnr3617mk.jpg'
                {% endif %}
                );
              "
            >
              {% comment %}
                {% if collection_image %}
                <img
                class="collection-swiper-image"
                      src="{{ collection_image |  image_url }}"
                      alt="{{ collection.title | escape }}"
                      width="100%"
                      height="100%"
                    >

                  {% else %}
                    {{ 'collection-1' | placeholder_svg_tag: 'collection-placeholder-image' }}
                  {% endif %}
              {% endcomment %}
              <div></div>
              <div class="collection-link">
                <div class="collection-title-wrapper">
                  {{ collection.title }}
                  <a
                    href="{{ collection.url }}"
                    class="shop-now-button"
                  >
                    SHOP NOW
                  </a>
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
      <div class="swiper-pagination"></div>
      <div class="swiper-button-prev pagination-arrows"></div>
      <div class="swiper-button-next pagination-arrows"></div>
    </div>
  </div>
</div>

<script>
  (function () {
    const swiper = new Swiper('.swiper-hero-slider', {
      direction: 'horizontal',

      pagination: {
        el: '.swiper-pagination',
        type: 'bullets',
        clickable: true,
      },

      navigation: {
        prevEl: '.swiper-button-prev',
        nextEl: '.swiper-button-next',
      },
    });
  })();
</script>

{% schema %}
{
  "name": "Collections Hero Section",
  "settings": [],
  "presets": [
    {
      "name": "Collections Hero Section"
    }
  ]
}
{% endschema %}
