<link rel="stylesheet" href="{{ 'blog.css' | asset_url }}">

<div class="bp-template-blog">
  {% if request.path contains '/tagged/' %}
    {% assign filter_applied = true %}
    {% assign split_path = request.path | split: '/tagged/' %}
    {% assign active_tags = split_path[1] | split: '+' -%}

    {% assign current_tag = active_tags[0] | split: '_' -%}
    {%- assign words = current_tag[1] | split: '-' %}
    {% assign formatted_tag = '' %}
    {% for word in words %}
      {% assign capitalized_word = word | capitalize %}
      {% if forloop.first %}
        {% assign formatted_tag = capitalized_word %}
      {% else %}
        {% assign formatted_tag = formatted_tag | append: ' ' | append: capitalized_word %}
      {% endif %}
    {% endfor %}

  {% else %}
    {% assign filter_applied = false %}
  {% endif %}
  {% if filter_applied == true %}
    <div class="bp-article-container">
      {% paginate blog.articles by section.settings.number_of_blog_posts %}
        <div class="">
          <h1 class="bp-header">
            {% comment %} <a href="/tagged/advice_how-to">advice tagged</a> {% endcomment %}
            {{ formatted_tag }} Articles
          </h1>
        </div>

        <div class="filter-drawer-container">
          <div class="filter-drawer-opener" onclick="openFilterDrawer()">
            {% render 'filter-icon' %}
            <span>Filters</span>
          </div>
          <div class="article-count">{{ blog.articles_count }} articles</div>

          {% comment %}---- From here the Filter drawer starts ----{% endcomment %}
          <div class="bp-filter-overlay" onclick="closeFilterDrawer()"></div>
          {% comment %} <div class="bp-filter-container"> {% endcomment %}
          <div class="bp-filter-drawer-container">
            <div class="bp-filter-drawer">
              <div class="bp-filter-drawer-header">
                <h1 class="bp-filter-drawer-title">Filters</h1>
                <div class="bp-filter-drawer-close-button" onclick="closeFilterDrawer()">
                  <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M21 21L1 1M21 1L1 21" stroke="#AAAAAA" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </div>
              </div>
              <div class="bp-filter-drawer-content">
                {% for block in section.blocks %}
                  {% assign tag_linked_list = linklists[block.settings.filter_parameter] %}
                  <div class="bp-filter-drawer-inner-items expanded">
                    <div
                      class="bp-filter-drawer-parameter bp-filter-drawer-parameter-{{ block.id }}"
                      onclick="toggleFilterParameters(this)"
                    >
                      <h2>
                        {{ tag_linked_list.title -}}
                      </h2>

                      <div class="dropdown-down-icon">
                        {% render 'dropdown-icon' %}
                      </div>
                    </div>
                    <div
                      class="bp-filter-tag-list-container bp-filter-tag-list-container-{{ block.id }}"
                    >
                      {% for link in tag_linked_list.links %}
                        {% assign present_tag = link.url | split: '/tagged/' %}
                        <div class="bp-filter-tag-container">
                          <label
                            for="bp-filter-tag-checkbox-{{ link.url }}"
                            class="bp-filter-tag-label"
                          >
                            {{ link.title }}
                          </label>
                          <input
                            value="{{ present_tag }}"
                            type="checkbox"
                            {% if active_tags contains present_tag[1] %}
                              checked
                            {% endif %}
                            class="bp-filter-tag-checkbox"
                            id="bp-filter-tag-checkbox-{{ link.url }}"
                          >
                        </div>
                      {% endfor %}
                    </div>
                  </div>
                {% endfor %}
              </div>
              <div class="bp-filter-drawer-footer">
                <button class="clear-tags" onclick="clearFilters('{{ split_path[0] }}')">Clear</button>
                <button class="apply-filters" onclick="applyFilters('{{ split_path[0] }}')">Apply Filters</button>
              </div>
            </div>
          </div>
          {% comment %} </div> {% endcomment %}
          {% comment %}----  Filter drawer ends ----{% endcomment %}
        </div>

        <div class="bp-article-grid">
          {% for article in blog.articles %}
            <div class="">
              <div class="bp-article-card">
                <div class="bp-article-image-container">
                  {% if article.image %}
                    <a href="{{ article.url }}">
                      <img
                        class="bp-article-image"
                        src="{{ article.image | image_url}}"
                        alt="Article Image"
                        height="100%"
                        width="100%"
                      >
                    </a>
                  {% else %}
                    {{ 'image' | placeholder_svg_tag: '' }}
                  {% endif %}
                </div>
                <div class="bp-article-details-container">
                  <div class="bp-article-details">
                    <h1 class="bp-article-title">{{ article.title }}</h1>
                    <div class="bp-aritcle-excerpt">
                      {% if article.excerpt.size > 0 %}
                        <p>{{ article.excerpt | strip_html | truncate: 150 }}</p>
                      {% else %}
                        <p>{{ article.content | strip_html | truncate: 150 }}</p>
                      {% endif %}
                    </div>

                    <div class="bp-author-info">
                      <img
                        class="bp-author-image"
                        src="{{ article.user.image  |  image_url  }}"
                        alt="Author Image"
                        height="60px"
                        width="60px"
                      >

                      <p>
                        by <span class="bp-author-name">{{ article.author }}</span>
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
        <div class="pagination">
          {% render 'pagination', paginate: paginate %}
        </div>
      {% endpaginate %}
    </div>
  {% endif %}
</div>

<script>
  function openFilterDrawer() {
    const overlay = document.querySelector('.bp-filter-overlay');
    // const container = document.querySelector('.bp-filter-container');
    overlay.style.display = 'block';
    const d_container = document.querySelector('.bp-filter-drawer-container');
    d_container.style.left = '0';
  }
  function closeFilterDrawer() {
    // const container = document.querySelector('.bp-filter-container');
    const overlay = document.querySelector('.bp-filter-overlay');

    overlay.style.display = 'none';
    console.log('Filter is clolsing..j;lkasjdf;l');
    const d_container = document.querySelector('.bp-filter-drawer-container');
    d_container.style.left = '-150vh';
  }

  function toggleFilterParameters(element) {
    const parentElement = element.parentElement;

    let isExpanded = parentElement.classList.contains('expanded');
    if (isExpanded) {
      parentElement.classList.remove('expanded');
      parentElement.classList.add('collapsed');
    } else {
      parentElement.classList.remove('collapsed');
      parentElement.classList.add('expanded');
    }
  }

  function clearFilters() {
    checkboxList = document.getElementsByClassName('bp-filter-tag-checkbox');

    Array.from(checkboxList).forEach((input) => {
      input.checked = false;
    });
  }
  function applyFilters(pathUrl) {
    checkboxList = document.getElementsByClassName('bp-filter-tag-checkbox');
    let url = pathUrl;
    let i = 0;
    Array.from(checkboxList).forEach((input) => {
      if (input.checked) {
        if (i == 0) {
          url = url + '/tagged/' + input.value;
          i++;
        } else url += `+${input.value}`;
      }
    });

    window.location = url;
  }
</script>

{% schema %}
{
  "name": "Blog Page",
  "settings": [
    {
      "type": "text",
      "id": "blog_read_more",
      "label": "Read more label",
      "default": "Read more"
    },
    {
      "type": "select",
      "id": "number_of_blog_posts",
      "label": "Blog posts per page",
      "options": [
        {
          "value": "6",
          "label": "6"
        },
        {
          "value": "12",
          "label": "12"
        },
        {
          "value": "18",
          "label": "18"
        },
        {
          "value": "24",
          "label": "24"
        }
      ],
      "default": "6"
    }
  ],
  "blocks": [
    {
      "type": "filter_parameter",
      "name": "Filter Parmeter",
      "settings": [
        {
          "type": "link_list",
          "id": "filter_parameter",
          "label": "Add Filter Parmeter"
        }
      ]
    }
  ]
}
{% endschema %}
