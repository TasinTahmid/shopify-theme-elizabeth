<link rel="stylesheet" href="{{ 'small-card-article-collection.css' | asset_url }}">

{% assign blog_filter_applied = false %}
{% if template.name == 'blog' and request.path contains '/tagged/' %}
  {% assign blog_filter_applied = true -%}
  {%- assign split_path = request.path | split: '/tagged/' %}
  {% assign path_before_tagged = split_path[0] %}

{% else %}
  {% assign path_before_tagged = request.path %}
{% endif %}

{% if blog_filter_applied == false %}
  <div class="small-card-article-collection-container">
    <div class="small-card-article-collection">
      <div class="sc-articles-header">
        <h1 class="sc-articles-section-title">{{ section.settings.section_title }}</h1>
        <a href="{{ path_before_tagged }}/tagged/{{section.settings.sc_article_tag}}" class="all-articles-link">
          See all articles
          <div class="all-articles-arrow-svg">
            <svg width="21" height="20" viewBox="0 0 21 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M20.416 10.0078H1.41602M11.416 18.9878L20.416 9.98779L11.416 0.987793" stroke="#747474" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>
        </a>
      </div>
      <div class="sc-article-slider">
        <div class="swiper swiper-small-article-card-{{ section.id }} overflow-visible">
          <div class="swiper-wrapper small-swiper-custom-property">
            {% for block in section.blocks %}
              <div class="swiper-slide ">
                <div class="small-article-card">
                  <div class="small-article-image-container">
                    <img
                      src="{{ block.settings.small_card_article.image | image_url }}"
                      class="small-article-image"
                      alt="Article Image"
                      height="100%"
                      width="100%"
                    >
                  </div>
                  <div class="small-article-details-container">
                    <div class="small-article-details">
                      <h2 class="small-article-title">
                        {% if block.settings.article_title != blank %}
                          {{ block.settings.article_title }}
                        {% else %}
                          {{ block.settings.small_card_article.title }}
                        {% endif %}
                      </h2>

                      <div class="small-aritcle-excerpt">
                        {% if block.settings.article_excerpt != blank %}
                          {{ block.settings.article_excerpt | strip_html | truncate: 150 }}
                        {% else %}
                          {% if article.excerpt.size > 0 %}
                            <p>{{ block.settings.small_card_article.excerpt | strip_html | truncate: 150 }}</p>
                          {% else %}
                            <p>{{ block.settings.small_card_article.content | strip_html | truncate: 150 }}</p>
                          {% endif %}
                        {% endif -%}
                      </div>

                      <a class="small-article-link-button" href="{{ block.settings.small_card_article.url }}">
                        {{- block.settings.button_label -}}
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
{% endif %}

<script>
  (function () {
    const swiper = new Swiper(`.swiper-small-article-card-{{ section.id }}`, {
      slidesPerView: 'auto',
      spaceBetween: 34,
    });
  })();
</script>

{% schema %}
{
  "name": "SC Article Collection",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title"
    },
    {
      "type": "text",
      "id": "sc_article_tag",
      "label": "Article tag"
    }
  ],
  "blocks": [
    {
      "type": "small_card_article",
      "name": "Small Card Article",
      "settings": [
        {
          "type": "article",
          "id": "small_card_article",
          "label": "Small Card Article"
        },
        {
          "type": "text",
          "id": "article_title",
          "label": "Article Title"
        },
        {
          "type": "textarea",
          "id": "article_excerpt",
          "label": "Article Excerpt"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Read more"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Small Card Articles"
    }
  ]
}
{% endschema %}
